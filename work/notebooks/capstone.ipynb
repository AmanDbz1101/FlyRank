"""Capstone Notebook — Reproducible outputs for the research paper.

Run this notebook top to bottom to regenerate all metrics, charts, and agent outputs.
All figures are saved to work/outputs/ for inclusion in the paper.
"""
# %% [markdown]
# # Agentic Content Decline Investigator — Capstone Notebook
#
# This notebook generates all outputs referenced in the research paper.
# Run top to bottom. All metrics are saved to `work/outputs/`.

# %%
import warnings
warnings.filterwarnings('ignore')

import os, sys, json, time
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

sys.path.insert(0, os.path.join(os.path.dirname(os.getcwd()), ".."))
os.chdir(os.path.dirname(os.path.abspath("__file__")))

from capstone.src.data.warehouse import load_population
from capstone.src.data.features import build_feature_vector, FEATURES8
from capstone.src.models.baseline import apply_baseline
from capstone.src.models.classifier import (
    train_and_evaluate, get_feature_importances, get_lr_coefficients,
)
from capstone.src.evaluation.metrics import evaluate_ranking, precision_at_k
from capstone.src.agents.pipeline import DeclineInvestigatorPipeline

sns.set_theme(style="whitegrid", font_scale=1.1)
OUT = "work/outputs"
os.makedirs(OUT, exist_ok=True)

# %% [markdown]
# ## 1. Load Data

# %%
print("Loading population...")
pop = load_population()
pop = build_feature_vector(pop)
pop = apply_baseline(pop)
print(f"Population: {len(pop):,} pages")
print(f"Base rate: {pop.is_declining.mean():.4f}")
print(f"Clients: {pop.client_hash_id.nunique()}")

# %% [markdown]
# ## 2. Train Models

# %%
fv_json = pop.to_json(orient="records")
results = train_and_evaluate(pop)
base_rate = pop.is_declining.mean()

# %% [markdown]
# ## 3. Model Comparison Table

# %%
models = {
    "Base rate": {"scores": np.full(len(pop), base_rate), "p_at_k": {}},
    "Baseline rule": {"scores": pop.baseline_score.values, "p_at_k": {}},
    "Logistic Regression": {"scores": results["lr"], "p_at_k": {}},
    "Random Forest": {"scores": results["rf"], "p_at_k": {}},
}

k_values = [10, 50, 100, 500]
y_true = results["y_true"]

rows = []
for name, m in models.items():
    row = {"Model": name}
    for k in k_values:
        p = precision_at_k(y_true, m["scores"], k)
        row[f"P@{k}"] = p
    try:
        from sklearn.metrics import roc_auc_score
        row["ROC AUC"] = roc_auc_score(y_true, m["scores"])
    except ValueError:
        row["ROC AUC"] = 0.5
    rows.append(row)

comparison = pd.DataFrame(rows).set_index("Model")
print("\n=== Model Comparison ===")
print(comparison.to_string())
comparison.to_csv(f"{OUT}/model_comparison.csv")

# %% [markdown]
# ## 4. Feature Importance + LR Coefficients

# %%
imp = get_feature_importances(pop)
coef = get_lr_coefs(pop) if hasattr(__import__('capstone.src.models.classifier', fromlist=['get_lr_coefficients']), 'get_lr_coefficients') else get_lr_coefficients(pop)

print("\n=== RF Feature Importance ===")
print(imp.to_string(index=False))

print("\n=== LR Coefficients (standardized) ===")
print(coef.to_string(index=False))

imp.to_csv(f"{OUT}/rf_importances.csv", index=False)
coef.to_csv(f"{OUT}/lr_coefficients.csv", index=False)

# %% [markdown]
# ## 5. Precision@K Chart

# %%
fig, ax = plt.subplots(figsize=(8, 5))
x = np.arange(len(k_values))
width = 0.25

for i, (name, m) in enumerate(models.items()):
    vals = [precision_at_k(y_true, m["scores"], k) for k in k_values]
    bars = ax.bar(x + i * width, vals, width, label=name, alpha=0.85)

ax.set_xlabel("K (top pages)")
ax.set_ylabel("Precision@K")
ax.set_title("Precision@K: Model Comparison")
ax.set_xticks(x + width)
ax.set_xticklabels([f"P@{k}" for k in k_values])
ax.legend()
ax.axhline(y=base_rate, color="gray", linestyle="--", alpha=0.5, label=f"Base rate ({base_rate:.3f})")
plt.tight_layout()
plt.savefig(f"{OUT}/precision_at_k.png", dpi=150, bbox_inches="tight")
plt.show()
print(f"Saved: {OUT}/precision_at_k.png")

# %% [markdown]
# ## 6. Feature Importance Chart

# %%
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# RF importance
imp_sorted = imp.sort_values("importance", ascending=True)
axes[0].barh(imp_sorted["feature"], imp_sorted["importance"], color="#0f3460")
axes[0].set_title("Random Forest Feature Importance")
axes[0].set_xlabel("Importance")

# LR coefficients
coef_sorted = coef.sort_values("coefficient", ascending=True)
colors = ["#e94560" if c < 0 else "#0f3460" for c in coef_sorted["coefficient"]]
axes[1].barh(coef_sorted["feature"], coef_sorted["coefficient"], color=colors)
axes[1].set_title("LR Coefficients (standardized)")
axes[1].set_xlabel("Coefficient")
axes[1].axvline(x=0, color="gray", linestyle="--", alpha=0.5)

plt.tight_layout()
plt.savefig(f"{OUT}/feature_analysis.png", dpi=150, bbox_inches="tight")
plt.show()
print(f"Saved: {OUT}/feature_analysis.png")

# %% [markdown]
# ## 7. Error Analysis — by Content Type

# %%
pop["pred_lr"] = results["lr"]
pop["pred_rf"] = results["rf"]
pop["correct_lr"] = ((pop.pred_lr > 0.5) == pop.is_declining).astype(int)

error_by_type = pop.groupby("content_type").agg(
    count=("is_declining", "size"),
    base_rate=("is_declining", "mean"),
    lr_precision=("correct_lr", "mean"),
).sort_values("count", ascending=False)

print("\n=== Error Analysis by Content Type ===")
print(error_by_type.to_string())
error_by_type.to_csv(f"{OUT}/error_by_content_type.csv")

# %% [markdown]
# ## 8. Agent Pipeline Demo

# %%
top_pages = pop.nlargest(10, "baseline_score")
pipeline = DeclineInvestigatorPipeline()

agent_results = []
for _, row in top_pages.iterrows():
    cid = row["content_hash_id"]
    features = {
        "content_hash_id": cid,
        "ctr_mar": float(row.ctr_mar),
        "mar_avg_position": float(row.mar_avg_position) if pd.notna(row.mar_avg_position) else 999,
        "mar_clicks": float(row.mar_clicks),
        "mar_impressions": float(row.mar_impressions),
        "momentum_feb_to_mar_pct": float(row.momentum_feb_to_mar_pct) if pd.notna(row.momentum_feb_to_mar_pct) else 0,
        "has_feb_data": int(row.has_feb_data),
        "has_clicks": int(row.has_clicks),
        "has_ga4": int(row.has_ga4),
    }
    context = {
        "content_type": str(row.content_type),
        "search_volume": float(row.search_volume) if pd.notna(row.search_volume) else 0,
        "content_age_days": 100,
    }

    result = pipeline.invoke({"features": features, "context": context})
    agent_results.append({
        "content_hash_id": cid,
        "content_type": row.content_type,
        "mar_impressions": row.mar_impressions,
        "ctr_mar": row.ctr_mar,
        "action": result.report["action"],
        "confidence": result.report["confidence"],
        "hypotheses": [h["code"] for h in result.plan["hypotheses"]],
        "evidence_count": result.investigation["hypotheses_tested"],
        "report": result.report["report"],
        "elapsed": result.elapsed_seconds,
    })

agent_df = pd.DataFrame(agent_results)
print("\n=== Agent Pipeline Results (Top 10) ===")
print(agent_df[["content_type", "mar_impressions", "ctr_mar", "action", "confidence"]].to_string())
agent_df.to_csv(f"{OUT}/agent_demo_results.csv", index=False)

# %% [markdown]
# ## 9. Save Final Metrics JSON

# %%
final_metrics = {
    "population": {
        "total_pages": int(len(pop)),
        "clients": int(pop.client_hash_id.nunique()),
        "base_rate": float(base_rate),
        "decision_moment": "2026-03-31",
        "features": FEATURES8,
    },
    "model_comparison": comparison.reset_index().to_dict(orient="records"),
    "agent_demo": {
        "pages_tested": len(agent_results),
        "actions": agent_df.action.value_counts().to_dict(),
        "avg_elapsed": float(agent_df.elapsed.mean()),
    },
}

with open(f"{OUT}/capstone_metrics.json", "w") as f:
    json.dump(final_metrics, f, indent=2, default=str)

print(f"\nAll outputs saved to {OUT}/")
print("Done.")
